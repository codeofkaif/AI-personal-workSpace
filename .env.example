# Copy this file to .env and replace all example credentials locally.
# Both start-backend.sh and start-rag.sh source the same root .env.

# Frontend (Vite)
VITE_API_URL=http://localhost:8080
VITE_RAG_URL=http://localhost:8000

# Spring Boot / PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/ai_workspace
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_workspace
DB_USER=your_local_db_user
DB_PASSWORD=
JWT_SECRET=replace-with-a-long-random-secret
RAG_BASE_URL=http://localhost:8000
# Must be the same value for Spring Boot and FastAPI. Do not commit real secrets.
RAG_API_KEY=replace-with-the-same-long-random-secret
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# FastAPI RAG service
RAG_ENV=development
RAG_HOST=127.0.0.1
RAG_PORT=8000
# Keep reload off to avoid unnecessary model reloads when virtualenv files change.
RAG_RELOAD=false
RAG_WARMUP_ON_STARTUP=false
RAG_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RAG_MAX_UPLOAD_BYTES=52428800
RAG_MAX_CONCURRENT_QUERIES=1
RAG_MAX_CONCURRENT_INGESTIONS=1

# OCR: digital text extraction works without Tesseract; scanned/image-only PDFs need the system binary.
OCR_ENABLED=true
OCR_LANG=eng

# Embeddings / chunking (vector column is vector(384); model changes require a full reindex)
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDING_DIMENSION=384
LEGACY_EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
CHUNK_SIZE_TOKENS=350
CHUNK_OVERLAP_TOKENS=50

# Retrieval
RAG_CANDIDATE_K=20
RAG_CONTEXT_CHUNKS=4
RAG_CONTEXT_TOKEN_BUDGET=1800
RAG_SIMILARITY_THRESHOLD=0.10
RERANK_ENABLED=true
RERANKER_MODEL_NAME=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# Local Ollama — ensure this exact tag appears in 'ollama list'
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b-q4_K_M
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=700
OLLAMA_TEMPERATURE=0.1
OLLAMA_TOP_P=0.85
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_THINK=true
