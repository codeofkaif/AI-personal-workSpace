# Frontend (Vite)
VITE_API_URL=http://localhost:8080
VITE_RAG_URL=http://localhost:8000

# Spring Boot / PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/ai_workspace
DB_USER=kaifkhan
DB_PASSWORD=
JWT_SECRET=local-development-only-change-before-deployment
RAG_BASE_URL=http://localhost:8000
# Use the same long random value in Spring Boot and FastAPI.
RAG_API_KEY=replace-with-a-long-random-secret
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# FastAPI RAG service
RAG_ENV=development
RAG_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RAG_MAX_UPLOAD_BYTES=52428800
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDING_DIMENSION=384
# Existing chunks were created with this model. Change only during a planned full reindex.
LEGACY_EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
CHUNK_SIZE_TOKENS=350
CHUNK_OVERLAP_TOKENS=50
RAG_CANDIDATE_K=20
RAG_SIMILARITY_THRESHOLD=0.10
# Optional cross-encoder; test quality/latency before enabling.
RERANK_ENABLED=true
RERANKER_MODEL_NAME=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# Ollama local inference
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=350
OLLAMA_TEMPERATURE=0.1
OLLAMA_TOP_P=0.85
OLLAMA_TIMEOUT_SECONDS=90
