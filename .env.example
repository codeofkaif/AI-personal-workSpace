# Frontend (Vite)
VITE_API_URL=http://localhost:8080
VITE_RAG_URL=http://localhost:8000

# Spring Boot / PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/ai_workspace
DB_USER=kaifkhan
DB_PASSWORD=
JWT_SECRET=local-development-only-change-before-deployment
RAG_BASE_URL=http://localhost:8000
# Use the same long random value in Spring Boot and FastAPI.
RAG_API_KEY=replace-with-a-long-random-secret
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# FastAPI RAG service
RAG_ENV=development
RAG_HOST=127.0.0.1
RAG_PORT=8000
RAG_RELOAD=true
# Enable to pay model-loading cost during startup rather than on the first query.
RAG_WARMUP_ON_STARTUP=false
RAG_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RAG_MAX_UPLOAD_BYTES=52428800
OCR_ENABLED=true
# Set eng+hin only when the Hindi Tesseract language data is installed.
OCR_LANG=eng
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDING_DIMENSION=384
# Existing chunks were created with this model. Change only during a planned full reindex.
LEGACY_EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
CHUNK_SIZE_TOKENS=350
CHUNK_OVERLAP_TOKENS=50
RAG_CANDIDATE_K=20
RAG_MAX_CONCURRENT_QUERIES=2
RAG_MAX_CONCURRENT_INGESTIONS=1
RAG_CONTEXT_CHUNKS=4
RAG_CONTEXT_TOKEN_BUDGET=1800
RAG_SIMILARITY_THRESHOLD=0.10
# Local multilingual cross-encoder reranking; benchmark end-to-end latency on your machine.
RERANK_ENABLED=true
RERANKER_MODEL_NAME=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# Ollama local inference
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=350
OLLAMA_TEMPERATURE=0.1
OLLAMA_TOP_P=0.85
OLLAMA_TIMEOUT_SECONDS=90
