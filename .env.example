# Copy this file to .env and replace local credentials/secrets before starting services.
# Never commit your real .env file.

# Frontend (Vite)
VITE_API_URL=http://localhost:8080
VITE_RAG_URL=http://localhost:8000

# Spring Boot / PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/ai_workspace
DB_USER=your_postgres_user
DB_PASSWORD=
JWT_SECRET=replace-with-a-long-random-secret
RAG_BASE_URL=http://localhost:8000
# Must be identical for the backend and RAG service.
RAG_API_KEY=replace-with-the-same-long-random-secret
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# FastAPI RAG service
# Vector store provider: qdrant is the target architecture; pgvector remains a rollback option.
RAG_VECTOR_BACKEND=qdrant

# Google Gemini embeddings. Add your real key to the ignored local .env only.
GEMINI_API_KEY=replace_me
GEMINI_MAX_RETRIES=3

# Qdrant local service (start with docker compose -f docker-compose.rag.yml up -d)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=ai_workspace_gemini_embedding_2_768_v1
QDRANT_TIMEOUT_SECONDS=10
QDRANT_SPARSE_MODEL=Qdrant/bm25
QDRANT_MIN_DENSE_SCORE=0.35
CHUNK_TOKENIZER=cl100k_base

RAG_ENV=development
RAG_HOST=127.0.0.1
RAG_PORT=8000
# Keep reload disabled by default to avoid repeated reloads caused by venv/cache files.
RAG_RELOAD=false
RAG_WARMUP_ON_STARTUP=false
RAG_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RAG_MAX_UPLOAD_BYTES=52428800
RAG_QUERY_CLARIFICATION_ENABLED=true
RAG_MAX_CONCURRENT_QUERIES=1
RAG_MAX_CONCURRENT_INGESTIONS=1
RAG_CANDIDATE_K=30
RAG_CONTEXT_CHUNKS=4
RAG_CONTEXT_TOKEN_BUDGET=1800
RAG_SIMILARITY_THRESHOLD=0.10

# Document extraction / OCR
OCR_ENABLED=true
# Use eng+hin only if both Tesseract language packs are installed.
OCR_LANG=eng

# Embeddings and chunking
EMBEDDING_MODEL_NAME=gemini-embedding-2
EMBEDDING_DIMENSION=768
# Change only during a planned full re-index.
LEGACY_EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=16
CHUNK_SIZE_TOKENS=450
CHUNK_OVERLAP_TOKENS=60

# Optional cross-encoder reranking. Enable only after measuring latency/memory on your machine.
RERANK_ENABLED=false
RERANKER_MODEL_NAME=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# Local Ollama inference
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b-q4_K_M
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=450
OLLAMA_TEMPERATURE=0.1
OLLAMA_TOP_P=0.85
OLLAMA_TIMEOUT_SECONDS=120
# false reduces latency; set true only if you prefer the model's thinking mode.
OLLAMA_THINK=false
